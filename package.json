{
  "name": "esport-control",
  "version": "1.0.0",
  "description": "Esport Control Panel for Tournament Management",
  "author": "PaperX",
  "main": "electron-main.cjs",
  "type": "module",
  "scripts": {
    "dev": "bun run index.ts",
    "electron": "electron .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "write": "bunx prettier . --write",
    "dev:css": "bun x @tailwindcss/cli -i ./src/main.css -o ./public/styles/tokens.css --watch",
    "build:css": "bun x @tailwindcss/cli -i ./src/main.css -o ./public/styles/tokens.css",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.6",
    "@types/bun": "^1.3.5",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "prettier": "3.7.4",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "com.paperx.esportcontrol",
    "productName": "Esport Control Panel",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "index.ts",
      "src/**/*",
      "public/**/*",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "tailwindcss": "^4.1.18"
  }
}
