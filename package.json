{
  "name": "esport-control",
  "version": "1.0.4",
  "description": "Esport Control Panel for Tournament Management",
  "author": "PaperX",
  "main": "electron-main.cjs",
  "type": "module",
  "scripts": {
    "dev": "bun run index.ts",
    "electron": "electron .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "build:server": "bun build --compile --minify --sourcemap index.ts --outfile src-tauri/binaries/esport-server-x86_64-pc-windows-msvc.exe",
    "build:prepare": "bun run scripts/pre-build.ts",
    "tauri:build": "bun run build:prepare && bun run build:server && tauri build",
    "write": "bunx prettier . --write"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.6",
    "@types/bun": "^1.3.5",
    "prettier": "3.7.4",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "obs-websocket-js": "^5.0.7",
    "tailwindcss": "^4.1.18"
  }
}