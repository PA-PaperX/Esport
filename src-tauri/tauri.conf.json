{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Esport Control Panel",
  "version": "1.0.0",
  "identifier": "com.paperx.esportcontrol",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../public",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Esport Control Panel",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
