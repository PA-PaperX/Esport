{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Esport Control Panel",
  "version": "1.0.2",
  "identifier": "com.paperx.esportcontrol",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "Esport Control Panel",
        "width": 1400,
        "height": 900,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/esport-server"
    ],
    "resources": [
      "public/**/*",
      "data/**/*",
      "obs/**/*",
      "resources/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  }
}